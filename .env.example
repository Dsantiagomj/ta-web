# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.
# Las variables sin el prefijo NEXT_PUBLIC_ solo existen en el servidor.

# Postgres. Vacío en local: la app usa la base embebida de `pnpm db:dev`.
# Para Neon u otro servidor, pon aquí su cadena de conexión.
DATABASE_URL=
# Solo para `pnpm migrate`: la URL directa de Neon (sin pooler). Las migraciones necesitan
# una sesión propia; la app sigue usando DATABASE_URL. Vacía: las migraciones usan DATABASE_URL.
DATABASE_URL_DIRECT=

# Clave con la que Payload firma las sesiones del panel. Obligatoria.
# Genera una con: openssl rand -hex 32
PAYLOAD_SECRET=

# URL pública de la web, sin barra final. Base de las URLs absolutas (metadatos, enlaces).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Entorno de la app. "dev" pone todo el sitio detrás de basic auth (salvo /api/health),
# añade X-Robots-Tag: noindex y robots.txt prohíbe rastrear. En Railway basta con su
# RAILWAY_ENVIRONMENT_NAME=dev, que Railway inyecta. Vacía en local y en producción.
APP_ENV=
# Usuario y contraseña de basic auth del entorno dev. En dev y sin alguna de las dos,
# la app responde 503 en vez de servir el sitio sin protección.
DEV_BASIC_AUTH_USER=
DEV_BASIC_AUTH_PASSWORD=

# Cloudflare R2 (API compatible con S3). Sin estas cuatro, los archivos se guardan en ./media.
# Con solo algunas, la app no arranca. Endpoint: https://<cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional; R2 usa "auto".
S3_REGION=
# Opcional: dominio CDN del bucket (https://media.torrentearcano.com). Si existe,
# las URLs de los archivos apuntan ahí en vez de pasar por /api/media.
MEDIA_BASE_URL=

# Solo `pnpm data:quests`: cuántas filas escribe a la vez en quests, items y monsters.
# Cada escritura ocupa una conexión del pool de Postgres (10), así que no pases de 9.
# Vacía: 8.
DOFUSDB_WRITE_CONCURRENCY=

# Pruebas E2E (pnpm test:e2e y pnpm test:e2e:dev-gate). Las configs de Playwright leen
# de .env solo estas tres.
# Puerto en el que arranca la app de las pruebas; por defecto 3100, para no chocar con pnpm dev.
E2E_PORT=3100
# Puerto de la app en modo dev de pnpm test:e2e:dev-gate; el siguiente es para la
# instancia sin credenciales. Por defecto 3101.
E2E_DEV_GATE_PORT=3101
# 1 reutiliza el último pnpm build en vez de compilar otra vez. Por defecto, vacío: compila.
E2E_SKIP_BUILD=

# Smoke tests (pnpm test:smoke) contra un entorno desplegado. playwright.config.ts las lee
# del entorno del proceso, nunca de este archivo: pásalas en la línea de comandos.
# URL del entorno, sin barra final. Vacía: las pruebas arrancan la app en local, como test:e2e.
SMOKE_BASE_URL=
# Basic auth del entorno (dev está detrás de basic auth). Solo se usan si están las dos.
SMOKE_BASIC_AUTH_USER=
SMOKE_BASIC_AUTH_PASSWORD=

# Commit desplegado que muestra /api/health. Railway inyecta RAILWAY_GIT_COMMIT_SHA, que
# gana; esta sirve para otros entornos. Vacía y sin la de Railway: "dev".
GIT_COMMIT_SHA=
# Versión desplegada que muestra /api/health. En producción la fija el workflow de
# release con la de la etiqueta (sin la v). Vacía: la de package.json.
APP_VERSION=

# Sentry: errores del servidor (src/instrumentation.ts). DSN del proyecto ta-web de la
# organización dsmjdev. Solo envía en los entornos dev y production de Railway; vacía en
# local y en CI, donde no sale nada. Es una variable de Railway, no se sube al repo.
SENTRY_DSN=
# Solo en `pnpm build`: token de Sentry para subir los mapas de código. Vacía: el build
# no los sube ni habla con Sentry. Aún no está en Railway.
SENTRY_AUTH_TOKEN=

# No van aquí: NODE_ENV, NEXT_PHASE y CI los fijan Next.js y GitHub Actions;
# DATABASE_CONNECTION, el script `pnpm migrate`; y RAILWAY_GIT_COMMIT_SHA y
# RAILWAY_ENVIRONMENT_NAME, Railway.

# --- Solo GitHub Actions (la app no las lee) -------------------------------
# Ambiente "production" de GitHub (release.yml):
# Token de proyecto de Railway con el que release.yml despliega producción.
RAILWAY_TOKEN=
# URL de producción, sin barra final (p. ej. https://ta-web-production.up.railway.app).
PROD_URL=
# Variable de repo (deploy-dev-smoke.yml): la URL de dev, https://…, sin barra final. El
# smoke de dev prueba esta URL y solo a ella envía las credenciales de dev.
DEV_URL=
