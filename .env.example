# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.
# Las variables sin el prefijo NEXT_PUBLIC_ solo existen en el servidor.

# Postgres. Vacío en local: la app usa la base embebida de `pnpm db:dev`.
# Para Neon u otro servidor, pon aquí su cadena de conexión.
DATABASE_URL=

# Clave con la que Payload firma las sesiones del panel. Obligatoria.
# Genera una con: openssl rand -hex 32
PAYLOAD_SECRET=

# URL pública de la web, sin barra final. Base de las URLs absolutas (metadatos, enlaces).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (API compatible con S3). Sin estas cuatro, los archivos se guardan en ./media.
# Con solo algunas, la app no arranca. Endpoint: https://<cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional; R2 usa "auto".
S3_REGION=
# Opcional: dominio CDN del bucket (https://media.torrentearcano.com). Si existe,
# las URLs de los archivos apuntan ahí en vez de pasar por /api/media.
MEDIA_BASE_URL=
