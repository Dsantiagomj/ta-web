# Gentleman Guardian Angel: revisión con IA de los archivos del commit contra AGENTS.md.
# https://github.com/Gentleman-Programming/gentleman-guardian-angel
#
# Proveedor: el CLI de Claude Code. GGA_PROVIDER lo sustituye en una ejecución sin
# tocar este archivo (GGA_PROVIDER=codex git commit …).
PROVIDER="claude"

# Lo que se revisa: código, estilos y docs.
FILE_PATTERNS="*.ts,*.tsx,*.js,*.mjs,*.css,*.md"

# Lo generado no se revisa: lockfile, tipos e import map de Payload, migraciones,
# tipos de Next y archivos minificados. Tampoco las skills de terceros de
# .claude/skills/: skills-lock.json las fija por hash y no se editan a mano. GGA
# compara los patrones sin barra con el nombre del archivo y los demás con la ruta
# completa.
EXCLUDE_PATTERNS="pnpm-lock.yaml,payload-types.ts,payload-generated-schema.ts,importMap.js,src/migrations/*,next-env.d.ts,*.d.ts,*.min.js,*.min.css,.next/*,.claude/skills/*"

RULES_FILE="AGENTS.md"

# Una respuesta ambigua del modelo cuenta como fallo.
STRICT_MODE="true"
TIMEOUT="300"

# Rama base de --pr-mode.
PR_BASE_BRANCH="main"
