{
  "name": "ta-web",
  "version": "0.0.0",
  "private": true,
  "description": "La web nueva de torrentearcano.com: Next.js con Payload CMS 3",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev-gate": "playwright test --config playwright.dev-gate.config.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:lhci": "node scripts/lhci.ts",
    "db:dev": "node scripts/db-dev.ts",
    "data:quests": "NODE_OPTIONS=--no-deprecation payload run scripts/refresh-quests.ts",
    "import:guides": "NODE_OPTIONS=--no-deprecation payload run scripts/import/import-guides.ts",
    "media:sizes": "NODE_OPTIONS=--no-deprecation payload run scripts/media-sizes.ts --",
    "migrate": "NODE_OPTIONS=--no-deprecation DATABASE_CONNECTION=direct payload migrate",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-cloud-storage": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@sentry/nextjs": "11.8.0",
    "graphql": "16.14.2",
    "next": "16.4.2",
    "payload": "3.92.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "railway": "3.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.12"
  }
}
