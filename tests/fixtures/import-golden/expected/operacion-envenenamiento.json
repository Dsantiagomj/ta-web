      },
      {
        "blockType": "step",
        "body": [
          {
            "blockType": "richText",
            "html": "<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Tienes que hablar con Peny Tenciario. Sigue el camino para ello:</p>"
          },
          {
            "alt": "Operación «envenenamiento»",
            "blockType": "image",
            "url": "https://images.squarespace-cdn.com/content/v1/67976884fd6bbb4c207d8c51/54bc8bcb-114e-4871-b74a-6ae510f8cadd/Captura+de+pantalla+2026-07-20+010229.png"
          },
          {
