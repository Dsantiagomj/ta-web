          {
            "blockType": "richText",
            "html": "<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">La misión empieza hablando con Oto Mustam [-25,33] una vez hayas terminado la misión anterior.</p>"
          },
          {
            "alt": "Operación «envenenamiento»",
            "blockType": "image",
